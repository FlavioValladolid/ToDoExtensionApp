{
  "manifest_version": 3,
  "name": "Tareas",
  "version": "1.0.0",
  "description": "Lista de tareas minimalista con captura de pantalla.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tareas"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
